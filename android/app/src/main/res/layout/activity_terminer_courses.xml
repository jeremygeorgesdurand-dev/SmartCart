<?xml version="1.0" encoding="utf-8"?>
<!-- Confirmation stylée pour le bouton ✓ "Terminer" du widget, sur le même
     modèle visuel que activity_quick_add.xml (carte sombre arrondie) au lieu
     du AlertDialog générique Android d'origine, qui jurait avec le reste de
     l'app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/quick_add_card_background">

        <TextView
            android:id="@+id/tc_icone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/quick_add_button_teal"/>

        <TextView
            android:id="@+id/tc_titre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Terminer les courses"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tc_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"
            android:gravity="center"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tc_annuler"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Annuler"
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tc_valider"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="Terminer"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/quick_add_button_teal"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
